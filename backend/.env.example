APP_NAME=JARVIS
VERSION=1.0.0
DB_URL=sqlite+aiosqlite:///./jarvis.db
JWT_SECRET=super_secret_key_change_me
AI_API_KEY=your_openai_api_key

# Memory
MEMORY_ENABLED=true
MAX_MEMORIES_PER_USER=1000
MEMORY_CONFIDENCE_THRESHOLD=0.7

# RAG
EMBEDDING_PROVIDER=mock
VECTOR_DIMENSION=1536
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
MAX_PDF_OCR_PAGES=100
PDF_RENDER_DPI=150
MAX_OCR_PAGE_PIXELS=20000000
OCR_TIMEOUT_SECONDS=30
VISION_TIMEOUT_SECONDS=30

# Voice
STT_PROVIDER=mock
TTS_PROVIDER=mock
STT_LANGUAGE=th
TTS_VOICE=alloy
TTS_SPEED=1.0
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=120
STORE_VOICE_AUDIO=false
