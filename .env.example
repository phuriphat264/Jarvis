APP_NAME=JARVIS
APP_ENV=development

DATABASE_URL=postgresql://jarvis_user:jarvis_password@postgres:5432/jarvis_db
JWT_SECRET=super_secret_jwt_key_please_change_in_production
LOG_LEVEL=INFO

AI_PROVIDER=mock
AI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_TIMEOUT=60
MAX_RETRIES=3
RETRY_DELAY=2
RECENT_MESSAGE_LIMIT=20

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_ENABLED=true
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.70
MAX_MEMORY_CONTEXT_TOKENS=1500
MEMORY_MIN_CONFIDENCE=0.75
MEMORY_MIN_IMPORTANCE=0.50

# Phase 5: Tools Configuration
TOOLS_ENABLED=true
MAX_TOOL_CALLS_PER_REQUEST=1

HTTP_TOOL_ENABLED=false
HTTP_ALLOWED_DOMAINS=
HTTP_TIMEOUT=10
HTTP_MAX_RESPONSE_SIZE=1048576
# Phase 6: Agent Runtime Configuration
MAX_AGENT_STEPS=6
MAX_AGENT_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=60
MAX_AGENT_TOKEN_BUDGET=8000

# Phase 7: Web Research Configuration
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
MAX_RESEARCH_QUERIES=3
MAX_SOURCES_PER_QUERY=5
MAX_SOURCES_TO_FETCH=8
MAX_CONTENT_LENGTH_PER_SOURCE=5000
MAX_TOTAL_RESEARCH_CONTENT=20000
RESEARCH_TIMEOUT_SECONDS=60

# Phase 8: Document Intelligence Configuration
FILE_STORAGE_PATH=./data/uploads
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_USER=100
MAX_DOCUMENT_PAGES=300
MAX_DOCUMENT_TEXT_LENGTH=1000000
MAX_SPREADSHEET_ROWS=10000
MAX_SPREADSHEET_CELLS=100000
MAX_PPTX_SLIDES=200
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.70
